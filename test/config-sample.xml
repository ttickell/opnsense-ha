<?xml version="1.0"?>
<opnsense>
  <interfaces>
    <wan>
      <if>vtnet0</if>
      <descr/>
      <enable>1</enable>
      <lock>1</lock>
      <ipaddr>dhcp</ipaddr>
      <ipaddrv6>dhcp6</ipaddrv6>
    </wan>
    <lan>
      <if>vtnet2</if>
      <descr/>
      <enable>1</enable>
      <ipaddr>10.220.1.2</ipaddr>
      <subnet>24</subnet>
    </lan>
    <lo0>
      <internal_dynamic>1</internal_dynamic>
      <descr>Loopback</descr>
      <enable>1</enable>
      <if>lo0</if>
      <ipaddr>127.0.0.1</ipaddr>
      <virtual>1</virtual>
    </lo0>
    <opt1>
      <if>vtnet1</if>
      <descr>WAN2</descr>
      <enable>1</enable>
      <lock>1</lock>
      <ipaddr>dhcp</ipaddr>
      <ipaddrv6>dhcp6</ipaddrv6>
    </opt1>
    <opt2>
      <if>vtnet3</if>
      <descr>PFSYNC</descr>
      <enable>1</enable>
      <ipaddr>10.220.3.2</ipaddr>
      <subnet>24</subnet>
    </opt2>
  </interfaces>
</opnsense>
