#!/bin/sh

# Early CARP Hook - Initialize WAN Interface State on Boot
# Prevents both firewalls from having WAN interfaces UP simultaneously
# Runs in rc.syshook.d/early/ before normal CARP daemon initialization

# Logging
log_tag="syshook-early-carp-init"

logger -p local3.info -t "$log_tag" "Starting early CARP boot initialization"

# Check if ha-singleton.conf exists
if [ ! -f "/usr/local/etc/ha-singleton.conf" ]; then
    logger -p local3.info -t "$log_tag" "ha-singleton.conf not found, skipping early WAN state setup"
    exit 0
fi

# Source the HA configuration
. /usr/local/etc/ha-singleton.conf

# If WAN_INTS not configured, nothing to do
if [ -z "$WAN_INTS" ]; then
    logger -p local3.info -t "$log_tag" "WAN_INTS not configured, skipping early WAN state setup"
    exit 0
fi

# Give CARP a moment to initialize its state
sleep 2

# Try to detect current CARP state by checking for a CARP interface
# Look for any interface with CARP status
carp_status=$(ifconfig | grep -i "carp:" | head -1)

if [ -z "$carp_status" ]; then
    logger -p local3.info -t "$log_tag" "No CARP interface found yet, deferring to normal CARP hooks"
    exit 0
fi

# Extract CARP state (MASTER, BACKUP, or INIT)
carp_state=$(echo "$carp_status" | grep -o "MASTER\|BACKUP\|INIT" | head -1)

logger -p local3.info -t "$log_tag" "Detected initial CARP state: $carp_state"

# If BACKUP, bring WAN interfaces down immediately to prevent dual-active scenario
if [ "$carp_state" = "BACKUP" ]; then
    logger -p local3.warn -t "$log_tag" "Node is BACKUP - bringing WAN interfaces DOWN"
    
    for iface in $WAN_INTS; do
        if ifconfig "$iface" | grep -q "UP,BROADCAST"; then
            logger -p local3.info -t "$log_tag" "Bringing down: $iface"
            ifconfig "$iface" down
        fi
    done
    
    logger -p local3.info -t "$log_tag" "WAN interfaces initialized to DOWN state (BACKUP role)"
else
    logger -p local3.info -t "$log_tag" "Node is $carp_state - WAN interfaces will be managed by normal CARP hooks"
fi

logger -p local3.info -t "$log_tag" "Early CARP boot initialization complete"
exit 0
