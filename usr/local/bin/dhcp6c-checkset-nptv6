#!/usr/local/bin/python3
#
# dhcp6c-checkset-nptv6 — reconcile OPNsense NPTv6 rules with current PD state
#
# Reads delegated-prefix JSON produced by dhcp6c-prefix-json and site
# configuration from /usr/local/etc/checkset-nptv6.yml.

import os
import sys
import json
import ipaddress
import syslog
from typing import Optional

_missing = []
try:
    import yaml
except ImportError:
    _missing.append("pyyaml  (install: pkg install py311-pyyaml)")

try:
    import requests
except ImportError:
    _missing.append("requests  (install: pkg install py311-requests)")

if _missing:
    syslog.openlog("dhcp6c-nptv6", syslog.LOG_PID, syslog.LOG_DAEMON)
    for dep in _missing:
        msg = f"Missing required Python package: {dep}"
        syslog.syslog(syslog.LOG_CRIT, msg)
        print(msg, file=sys.stderr)
    sys.exit(1)

try:
    import urllib3
except ImportError:
    urllib3 = None

CONFIG_FILE = "/usr/local/etc/checkset-nptv6.yml"
REQUEST_TIMEOUT = 15
MAX_RETRIES = 3

SYSLOG_TAG = "dhcp6c-nptv6"
syslog.openlog(SYSLOG_TAG, syslog.LOG_PID, syslog.LOG_DAEMON)

REQUEST_VERIFY_TLS = True


def log_info(msg: str) -> None:
    syslog.syslog(syslog.LOG_INFO, msg)


def log_warn(msg: str) -> None:
    syslog.syslog(syslog.LOG_WARNING, msg)


def log_err(msg: str) -> None:
    syslog.syslog(syslog.LOG_ERR, msg)


def _to_bool(value, default: bool = True) -> bool:
    if value is None:
        return default
    if isinstance(value, bool):
        return value
    text = str(value).strip().lower()
    if text in ("1", "true", "yes", "on"):
        return True
    if text in ("0", "false", "no", "off"):
        return False
    return default


REQUIRED_KEYS = ["api-base", "api-key", "api-secret", "dhcp6c-pds-file", "ipv6-ula"]


def validate_config(cfg: dict) -> None:
    missing = [k for k in REQUIRED_KEYS if not cfg.get(k)]
    if missing:
        log_err(f"Config {CONFIG_FILE} is missing required keys: {missing}")
        sys.exit(1)

    for placeholder in ["YOUR-OPNSENSE-HOST", "YOUR-API-KEY", "YOUR-API-SECRET", "fdXX"]:
        for key in ("api-base", "api-key", "api-secret", "ipv6-ula"):
            if placeholder in str(cfg.get(key, "")):
                log_err(f"Config {CONFIG_FILE} key '{key}' still contains placeholder value")
                sys.exit(1)


def _api_get(url: str, auth: tuple, retries: int = MAX_RETRIES) -> dict:
    last_exc = None
    for attempt in range(1, retries + 1):
        try:
            resp = requests.get(
                url,
                auth=auth,
                timeout=REQUEST_TIMEOUT,
                verify=REQUEST_VERIFY_TLS,
            )
            resp.raise_for_status()
            return resp.json()
        except (requests.RequestException, ValueError) as exc:
            last_exc = exc
            log_warn(f"GET {url} attempt {attempt}/{retries} failed: {exc}")
    log_err(f"GET {url} failed after {retries} attempts: {last_exc}")
    raise RuntimeError(f"API GET failed: {url}") from last_exc


def _api_post(url: str, auth: tuple, data: dict, retries: int = MAX_RETRIES) -> dict:
    last_exc = None
    for attempt in range(1, retries + 1):
        try:
            resp = requests.post(
                url,
                auth=auth,
                json=data,
                timeout=REQUEST_TIMEOUT,
                verify=REQUEST_VERIFY_TLS,
            )
            resp.raise_for_status()
            result = resp.json()
            if isinstance(result, dict) and result.get("result") == "failed":
                raise ValueError(f"API returned result=failed: {result}")
            return result
        except (requests.RequestException, ValueError) as exc:
            last_exc = exc
            log_warn(f"POST {url} attempt {attempt}/{retries} failed: {exc}")
    log_err(f"POST {url} failed after {retries} attempts: {last_exc}")
    raise RuntimeError(f"API POST failed: {url}") from last_exc


def ipv6_network_calc(avail_pds: dict, pd_id: int, sla: int, prefix_len: int) -> Optional[str]:
    entry = avail_pds.get(str(pd_id))
    if not entry:
        log_err(f"PD id {pd_id} not found in state file — check your config")
        return None

    pd_net = ipaddress.IPv6Network(entry["prefix"], strict=True)
    if prefix_len == 0:
        return str(pd_net)

    target_len = pd_net.prefixlen + prefix_len
    subnets = list(pd_net.subnets(new_prefix=target_len))
    if sla >= len(subnets):
        log_err(f"PD {pd_id}: SLA index {sla} out of range for prefix_len {prefix_len}")
        return None
    return str(subnets[sla])


def ipv6_in_ula(ula_prefix: str, address: str) -> bool:
    ula_net = ipaddress.IPv6Network(ula_prefix, strict=False)
    iface = ipaddress.IPv6Interface(address)
    return iface.ip in ula_net


def ipv6_network_from_interface(address: str) -> str:
    return str(ipaddress.IPv6Interface(address).network)


def npt_rule_add(source_net: str, dest_net: str, wan_iface_identifier: str,
                 lan_label: str, wan_label: str,
                 url_base: str, key: str, secret: str) -> None:
    url = url_base + "/firewall/npt/addRule"
    desc = f"{lan_label}<->{wan_label} dhcp6c-checkset-nptv6"
    body = {"rule": {
        "enabled": 1,
        "sequence": "1",
        "log": "0",
        "interface": wan_iface_identifier,
        "source_net": source_net,
        "destination_net": dest_net,
        "description": desc,
    }}
    _api_post(url, (key, secret), body)
    log_info(f"Added NPTv6 rule: {source_net} <-> {dest_net} via {wan_iface_identifier}")


def npt_rule_del(uuid: str, url_base: str, key: str, secret: str) -> None:
    url = url_base + f"/firewall/npt/delRule/{uuid}"
    _api_post(url, (key, secret), {})
    log_info(f"Deleted NPTv6 rule uuid={uuid}")


def npt_rule_apply(url_base: str, key: str, secret: str) -> None:
    url = url_base + "/firewall/npt/apply"
    _api_post(url, (key, secret), {})
    log_info("Applied NPTv6 rule changes")


def _normalize_iface_map(iface_map_raw):
    if isinstance(iface_map_raw, list):
        return iface_map_raw
    if isinstance(iface_map_raw, dict):
        if isinstance(iface_map_raw.get("rows"), list):
            return iface_map_raw["rows"]
        if isinstance(iface_map_raw.get("data"), list):
            return iface_map_raw["data"]
    return []


def main() -> None:
    global REQUEST_VERIFY_TLS

    if not os.path.exists(CONFIG_FILE):
        log_err(
            f"Configuration file not found: {CONFIG_FILE} "
            f"(copy from {CONFIG_FILE}.example and fill in values)"
        )
        sys.exit(1)

    with open(CONFIG_FILE, "r") as fh:
        config = yaml.safe_load(fh)

    if not isinstance(config, dict):
        log_err(f"Config {CONFIG_FILE} is not a valid YAML mapping")
        sys.exit(1)

    validate_config(config)

    url_base = config["api-base"].rstrip("/")
    api_key = config["api-key"]
    api_secret = config["api-secret"]
    pds_file = config["dhcp6c-pds-file"]
    ula_prefix = config["ipv6-ula"]

    REQUEST_VERIFY_TLS = _to_bool(config.get("api-verify-tls"), True)
    if not REQUEST_VERIFY_TLS:
        log_warn("TLS certificate verification disabled for OPNsense API (api-verify-tls=false)")
        if urllib3 is not None:
            urllib3.disable_warnings(urllib3.exceptions.InsecureRequestWarning)

    if config.get("ca-bundle"):
        os.environ["REQUESTS_CA_BUNDLE"] = config["ca-bundle"]

    if not os.path.exists(pds_file):
        log_err(f"PD state file not found: {pds_file} — run dhcp6c-prefix-json first")
        sys.exit(1)

    with open(pds_file, "r") as fh:
        raw = json.load(fh)

    avail_pds = raw.get("prefix_delegations", raw)
    active_pds = {k: v for k, v in avail_pds.items() if v.get("status") == "active"}

    if not active_pds:
        log_warn("No active prefix delegations found — nothing to reconcile")
        sys.exit(0)

    log_info(f"Reconciling NPTv6 rules against {len(active_pds)} active PD(s)")

    iface_map_raw = _api_get(url_base + "/interfaces/overview/export", (api_key, api_secret))
    iface_map = _normalize_iface_map(iface_map_raw)

    global_devs = {}
    for entry in iface_map:
        identifier = entry.get("identifier") or entry.get("device", "")
        description = entry.get("description", "")
        global_devs[description] = {"identifier": identifier}

    npt_config = _api_get(url_base + "/firewall/npt/searchRule", (api_key, api_secret))

    for row in npt_config.get("rows", []):
        row["_desired"] = False

    rules_added = 0
    rules_skipped = 0
    apply_needed = False

    for lan_label, lan_cfg in config.get("lan-interfaces", {}).items():
        real_iface = lan_cfg.get("interface")
        if not real_iface:
            log_warn(f"lan-interfaces.{lan_label} missing 'interface' key — skipping")
            continue

        try:
            iface_data = _api_get(
                url_base + f"/interfaces/overview/getInterface/{real_iface}",
                (api_key, api_secret),
            )
        except RuntimeError as exc:
            log_warn(f"Could not fetch interface data for {real_iface}: {exc} — skipping")
            continue

        ula_addr = None
        for item in iface_data.get("message", {}).get("ipv6", {}).get("value", []):
            addr = item.get("ipaddr", "")
            if addr and ipv6_in_ula(ula_prefix, addr):
                ula_addr = addr
                break

        if not ula_addr:
            log_info(f"{lan_label} ({real_iface}): no ULA address — skipping")
            continue

        source_net = ipv6_network_from_interface(ula_addr)
        log_info(f"{lan_label} ({real_iface}): ULA source net {source_net}")

        for wan_label, mapping in lan_cfg.get("mappings", {}).items():
            pd_id = mapping.get("pd-id")
            pd_sla = mapping.get("pd-sla", 0)
            pd_len = mapping.get("pd-len", 0)

            dest_net = ipv6_network_calc(active_pds, pd_id, pd_sla, pd_len)
            if dest_net is None:
                log_warn(f"  {wan_label}: could not compute dest_net for pd-id={pd_id} — skipping")
                continue

            existing_row = None
            for row in npt_config.get("rows", []):
                if row.get("source_net") == source_net and row.get("destination_net") == dest_net:
                    existing_row = row
                    break

            if existing_row is not None:
                existing_row["_desired"] = True
                rules_skipped += 1
                log_info(f"  {wan_label}: rule {source_net} <-> {dest_net} already correct")
            else:
                wan_dev = global_devs.get(wan_label, {})
                identifier = wan_dev.get("identifier")
                if not identifier:
                    log_warn(f"  {wan_label}: OPNsense interface not found in interface export — skipping add")
                    continue
                try:
                    npt_rule_add(source_net, dest_net, identifier, lan_label, wan_label,
                                 url_base, api_key, api_secret)
                    rules_added += 1
                    apply_needed = True
                except RuntimeError as exc:
                    log_err(f"  {wan_label}: failed to add rule {source_net} <-> {dest_net}: {exc}")

    if apply_needed:
        try:
            npt_rule_apply(url_base, api_key, api_secret)
        except RuntimeError as exc:
            log_err(f"Failed to apply NPTv6 changes: {exc}")

    rules_deleted = 0
    for row in npt_config.get("rows", []):
        if not row.get("_desired", False):
            uuid = row.get("uuid", "")
            if not uuid:
                continue
            try:
                npt_rule_del(uuid, url_base, api_key, api_secret)
                rules_deleted += 1
                apply_needed = True
            except RuntimeError as exc:
                log_err(f"Failed to delete stale rule uuid={uuid}: {exc}")

    if rules_deleted:
        try:
            npt_rule_apply(url_base, api_key, api_secret)
        except RuntimeError as exc:
            log_err(f"Failed to apply NPTv6 cleanup: {exc}")

    log_info(
        f"Reconciliation complete: {rules_added} added, "
        f"{rules_skipped} unchanged, {rules_deleted} deleted"
    )


if __name__ == "__main__":
    main()
